<svg width="320" height="80" viewBox="0 0 320 80" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="320" height="80" fill="#ffffff"></rect>

  <!-- Left red square -->
  <rect x="0" y="0" width="80" height="80" fill="#c00000"></rect>

  <!-- Concentric green squares -->
  <rect x="8" y="8" width="64" height="64" fill="none" stroke="#00a651" stroke-width="3"></rect>
  <rect x="16" y="16" width="48" height="48" fill="none" stroke="#00a651" stroke-width="3"></rect>
  <rect x="24" y="24" width="32" height="32" fill="none" stroke="#00a651" stroke-width="3"></rect>
  <rect x="32" y="32" width="16" height="16" fill="none" stroke="#00a651" stroke-width="3"></rect>

  <!-- Right green rectangle -->
  <rect x="86" y="0" width="234" height="80" fill="#00a651"></rect>

  <!-- Text: NAVSAR GROUP -->
  <text x="100" y="32" font-family="Arial, Helvetica, sans-serif" font-size="24" font-weight="700" fill="#ffffff">
    NAVSAR
  </text>
  <text x="100" y="58" font-family="Arial, Helvetica, sans-serif" font-size="24" font-weight="700" fill="#ffffff">
    GROUP
  </text>
</svg>
